  "panels": [
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Use the Service filter to load only the container logs needed for the current investigation.",
      "gridPos": {
        "h": 13,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "dedupStrategy": "none",
        "enableInfiniteScrolling": false,
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{app=\"opswatch\", service_name=~\"${service_name:regex}\"}",
          "maxLines": 300,
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Logs for $service_name",
      "type": "logs"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Shows a smaller result set containing common failure words for the selected service.",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "id": 2,
      "options": {
        "dedupStrategy": "none",
        "enableInfiniteScrolling": false,
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{app=\"opswatch\", service_name=~\"${service_name:regex}\"} |~ \"(?i)(error|failed|exception|timeout)\"",
          "maxLines": 100,
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Errors and failures for $service_name",
      "type": "logs"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "opswatch",
    "logs"
  ],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "definition": "label_values({app=\"opswatch\"}, service_name)",
        "description": "Choose which OpsWatch container logs the panels should load.",
        "hide": 0,
        "includeAll": true,
        "label": "Service",
        "multi": false,
        "name": "service_name",
        "options": [],
        "query": {
          "label": "service_name",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "stream": "{app=\"opswatch\"}",
          "type": 1
        },
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-10m",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "OpsWatch Logs",
  "uid": "opswatch-logs",
  "version": 2,
  "weekStart": ""
}
